# .env.example
# Cyber Threat Intelligence Multi-Agent System
# Copy this file to .env and fill in your API keys

# ── Primary LLM Provider (OpenRouter) ────────────────────────────────────
# Required: Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3-haiku

# ── Alternative LLM Providers (optional fallback) ────────────────────────
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── External Threat-Intel APIs (optional) ────────────────────────────────
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
NVD_API_KEY=your_nvd_api_key_here

# ── Database (optional) ─────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here

# ── System Settings ─────────────────────────────────────────────────────
DEFAULT_LLM=openrouter
LOG_LEVEL=INFO
STREAMLIT_PORT=8501
STREAMLIT_ADDRESS=0.0.0.0

# ── Security (optional) ─────────────────────────────────────────────────
SECURITY_WHITELIST=your_company_domain.com